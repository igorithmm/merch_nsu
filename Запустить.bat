@echo off
rem Zapusk prilozheniya "Merch NGU". Dvoynoy klik po etomu faylu.
rem Vsyo obshchenie s polzovatelem idet iz Python i iz okna Windows -
rem sam .bat ostayotsya v ASCII, chtoby ne zaviset ot kodirovki konsoli.
cd /d "%~dp0"

set "PY="
where pythonw.exe >nul 2>&1 && set "PY=pythonw.exe"
if not defined PY where py.exe >nul 2>&1 && set "PY=py.exe -3w"
if not defined PY where python.exe >nul 2>&1 && set "PY=python.exe"
if not defined PY goto nopython

start "" %PY% "%~dp0run.py"
exit /b 0

:nopython
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
exit /b 1
